# ============================================================
# Crater MCP 配置示例：复制为 .env 或直接写进 agent 的 MCP 配置里
# 所有变量都只在本地 MCP 进程里使用，不会发给 LLM
# ============================================================

# --- 必填：平台地址 ---
# 面板入口（ingress VIP）或 NodePort 都可以
CRATER_BASE_URL=http://172.16.16.140

# --- 身份（二选一）---
# 方式 A：用户名密码（推荐，token 过期会自动重新登录）
CRATER_USERNAME=crater-admin
CRATER_PASSWORD=changeme

# 方式 B：直接给 token（适合 CI / 已有 JWT 的场景，注意会过期）
# CRATER_ACCESS_TOKEN=
# CRATER_REFRESH_TOKEN=

# --- 可选：登录后切换到指定账号（Crater 的「项目」）---
# 不填则停留在登录返回的默认账号；填了会在 login 后调用 /api/v1/auth/switch
# CRATER_ACCOUNT=q-3

# --- 安全闸门（默认值即最安全配置）---
# 只读模式：true 时所有写操作工具直接拒绝，不发请求
CRATER_READ_ONLY=false
# 是否允许管理端工具（/api/v1/admin/**）。false 时即使本人是管理员也不注册
CRATER_ALLOW_ADMIN=true
# 严格自身作用域：对「后端不做归属校验」的危险接口额外拦截（见 docs/mcp-design.md §4）
CRATER_ENFORCE_SELF_SCOPE=true

# --- 进阶 ---
# storage-server 若与主后端不同域，可单独指定；默认复用 CRATER_BASE_URL
# CRATER_STORAGE_BASE_URL=http://172.16.16.140
# 请求超时（毫秒）
CRATER_TIMEOUT_MS=30000
# 上传/下载超时（毫秒）
CRATER_TRANSFER_TIMEOUT_MS=600000
# 本地文件落地目录（上传源、下载目标），默认系统临时目录
# CRATER_WORK_DIR=
