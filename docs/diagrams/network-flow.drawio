<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Network-Flow" id="network-flow">
    <mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c3" value="Crater 网络通信流程（以一次页面访问 + 一次作业内出向为例）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="34" as="geometry"/></mxCell>
        <mxCell id="c4" value="入向：浏览器 → Crater 前端 / 后端 / 文件 / 作业入口" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#2f5b8a;fontSize=12.5;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="260" y="54" width="320" height="26" as="geometry"/></mxCell>
        <mxCell id="c5" value="出向：作业 Pod 主动发起的通信" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#8a5a00;fontSize=12.5;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="1010" y="54" width="300" height="26" as="geometry"/></mxCell>
        <mxCell id="c6" value="① 用户点击页面&#xa;https://172.16.16.140/portal/..." style="ellipse;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#eef2f7;strokeColor=#666666;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="88" width="340" height="56" as="geometry"/></mxCell>
        <mxCell id="c7" value="② 地址解析 → VIP&#xa;172.16.16.140:80（内网直连，无外部 DNS）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="260" y="172" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="c8" value="③ 节点内核 Cilium eBPF&#xa;查 Service map：VIP:80 → 10.52.0.34:80&#xa;DNAT + 负载均衡（无 iptables、无进程监听）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ece9fb;strokeColor=#8b7fd4;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="258" width="340" height="68" as="geometry"/></mxCell>
        <mxCell id="c9" value="④ 进入 ingress-nginx Pod（llm004）&#xa;读取 Host + path，匹配 15 条 ingress 规则" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="260" y="354" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="c10" value="命中规则？" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#fffde7;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="442" width="260" height="74" as="geometry"/></mxCell>
        <mxCell id="c11" value="⑤ 选后端 Service，再次 DNAT&#xa;ClusterIP 虚拟端口 → 目标 Pod IP:Port" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="260" y="546" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="c12" value="入向策略&#xa;放行？" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="634" width="240" height="82" as="geometry"/></mxCell>
        <mxCell id="c13" value="⑥ 容器进程处理请求&#xa;（前端静态页 / Go API / webdav / Jupyter）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="260" y="746" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="c14" value="⑦ 回程：conntrack 反查&#xa;原路返回，eBPF 还原客户端 IP" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ece9fb;strokeColor=#8b7fd4;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="260" y="832" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="c15" value="⑧ 浏览器渲染 / 客户端收到响应" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#eef2f7;strokeColor=#666666;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="918" width="340" height="52" as="geometry"/></mxCell>
        <mxCell id="c16" value="404 / default backend&#xa;（无匹配规则）" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="460" width="190" height="56" as="geometry"/></mxCell>
        <mxCell id="c17" value="连接超时&#xa;（策略静默丢弃）" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="652" width="190" height="56" as="geometry"/></mxCell>
        <mxCell id="c18" value="/ 　→ crater-frontend-svc:80&#xa;→ 前端 Pod nginx:80&#xa;策略：无限制 ✅" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="96" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="c19" value="/api → crater-backend-svc:80&#xa;→ 后端 Pod Go:8088&#xa;策略：无限制 ✅" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="178" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="c20" value="/api/ss → crater-acl-gw:7320&#xa;→ storage-server → PVC&#xa;策略：无限制 ✅" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="260" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="c21" value="/ingress/&lt;baseURL&gt; → svc-*-notebook:8888&#xa;→ 作业 Pod&#xa;策略：需 allow-ingress-nginx ⚠" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="700" y="342" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="c22" value="① 作业 Pod 主动发起连接" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#fff7e6;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="88" width="320" height="52" as="geometry"/></mxCell>
        <mxCell id="c23" value="② 出向策略检查&#xa;作业 NetworkPolicy 只有 policyTypes: Ingress&#xa;→ 出向不限（eBPF 直接转发）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="164" width="320" height="66" as="geometry"/></mxCell>
        <mxCell id="c24" value="目标是？" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#fffde7;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="252" width="200" height="78" as="geometry"/></mxCell>
        <mxCell id="c25" value="集群内 Service / 其它 Pod&#xa;eBPF 转发 + 对端入向策略&#xa;（跨作业 = 丢包）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1050" y="366" width="220" height="74" as="geometry"/></mxCell>
        <mxCell id="c26" value="Harbor 拉镜像&#xa;172.16.16.126:30003（NodePort）&#xa;经 masquerade 出 ens12" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1290" y="366" width="200" height="74" as="geometry"/></mxCell>
        <mxCell id="c27" value="DNS 解析&#xa;CoreDNS 10.43.0.10" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1050" y="470" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="c28" value="集群外 / 互联网&#xa;SNAT 后从节点网卡出去" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1290" y="470" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="c29" value="Kubernetes API&#xa;10.43.0.1:443 → 172.16.16.126:6443" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="1080" y="560" width="320" height="56" as="geometry"/></mxCell>
        <mxCell id="c30" value="作业内进程拿到结果" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#fff7e6;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="646" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="c31" value="为什么端口不冲突（三层各管一段）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1080" y="726" width="320" height="30" as="geometry"/></mxCell>
        <mxCell id="c32" value="VIP:80 / NodePort 32057 = eBPF 规则（无 socket）&#xa;ingress Pod 内 :80 = Pod netns 内的真实监听&#xa;ClusterIP :80 = 虚拟端口，可无限复用&#xa;容器可监听别的端口（后端 :80 → :8088）&#xa;只有 NodePort / hostPort 全局唯一" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;lineHeight=150;" vertex="1" parent="1"><mxGeometry x="1080" y="762" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="c33" value="两个最容易踩的坑" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1080" y="906" width="320" height="30" as="geometry"/></mxCell>
        <mxCell id="c34" value="① 作业入口打不开：同作业 NetworkPolicy 未放行&#xa;   ingress-nginx（需加 namespaceSelector 放行）&#xa;② Pod 声明 hostPort:80 会和 VIP 抢流量&#xa;   （节点上本来没人监听 80，绑得上但分流错乱）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;lineHeight=150;" vertex="1" parent="1"><mxGeometry x="1080" y="942" width="320" height="96" as="geometry"/></mxCell>
        <mxCell id="c35" value="注：图中「策略判定」由 Cilium eBPF 在 Pod 入口处执行——NetworkPolicy 是声明，实际拒绝发生在内核。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#fffde7;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="1340" height="34" as="geometry"/></mxCell>
        <mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#3b6ea5;strokeWidth=1.7;fontColor=#3b6ea5;fontSize=10.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#3b6ea5;strokeWidth=1.7;fontColor=#3b6ea5;fontSize=10.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c38" value="DNAT 到 10.52.0.34:80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#8b7fd4;strokeWidth=1.7;fontColor=#8b7fd4;fontSize=10.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#3b6ea5;strokeWidth=1.7;fontColor=#3b6ea5;fontSize=10.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c40" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#b85450;strokeWidth=1.7;fontColor=#b85450;fontSize=10.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="479"/><mxPoint x="660" y="488"/></Array></mxGeometry></mxCell>
        <mxCell id="c41" value="是：按 path 匹配" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#82b366;strokeWidth=1.7;fontColor=#82b366;fontSize=10.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#3b6ea5;strokeWidth=1.7;fontColor=#3b6ea5;fontSize=10.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c43" value="拒绝" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#b85450;strokeWidth=1.7;fontColor=#b85450;fontSize=10.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="675"/><mxPoint x="660" y="680"/></Array></mxGeometry></mxCell>
        <mxCell id="c44" value="放行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#82b366;strokeWidth=1.7;fontColor=#82b366;fontSize=10.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#3b6ea5;strokeWidth=1.7;fontColor=#3b6ea5;fontSize=10.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#8b7fd4;strokeWidth=1.7;fontColor=#8b7fd4;fontSize=10.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#82b366;strokeWidth=1.7;fontColor=#82b366;fontSize=9;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#82b366;strokeWidth=1.7;fontColor=#82b366;fontSize=9;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#82b366;strokeWidth=1.7;fontColor=#82b366;fontSize=9;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#d79b00;strokeWidth=1.7;fontColor=#d79b00;fontSize=9;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#d79b00;strokeWidth=1.7;fontColor=#d79b00;fontSize=10.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
