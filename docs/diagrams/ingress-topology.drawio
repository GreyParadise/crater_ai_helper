        <mxCell id="c12" value="CLI / Agent(MCP)　crater-cli · curl" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=13;fontStyle=1;" vertex="1" parent="c5"><mxGeometry x="400" y="46" width="320" height="56" as="geometry"/></mxCell>
