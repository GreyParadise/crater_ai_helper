        <mxCell id="c14" value="VIP 172.16.16.140 :80 / :443&#xa;Cilium eBPF LB（无 socket 监听）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#8b7fd4;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=13;fontStyle=1;" vertex="1" parent="c6"><mxGeometry x="40" y="44" width="400" height="60" as="geometry"/></mxCell>
        <mxCell id="c15" value="NodePort 32057 (http) / 31432 (https)&#xa;备用入口，同样由 eBPF 处理" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#8b7fd4;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=12;" vertex="1" parent="c6"><mxGeometry x="470" y="44" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="c16" value="LB IPAM 池 01-lb-pool（余 49）· L2 announcement @ens12&#xa;k3s servicelb 已 --disable · KubeProxyReplacement=True" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="c6"><mxGeometry x="840" y="44" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="c17" value="ingress-nginx-controller　Pod 10.52.0.34&#xa;Deployment ×1 副本 · 节点 llm004" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=13;fontStyle=1;" vertex="1" parent="c7"><mxGeometry x="40" y="44" width="420" height="60" as="geometry"/></mxCell>
        <mxCell id="c18" value="ConfigMap：forwarded-headers ✓ · server-tokens=false · gzip=on&#xa;⚠ snippet 注解 risk=Critical　⚠ proxy-body-size 默认 1m" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="c7"><mxGeometry x="490" y="44" width="600" height="60" as="geometry"/></mxCell>
        <mxCell id="c19" value="path /　crater-frontend-svc&#xa;ClusterIP :80 → Pod :80" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;fontStyle=1;" vertex="1" parent="c8"><mxGeometry x="30" y="66" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="c20" value="path /api　crater-backend-svc&#xa;ClusterIP :80 → Pod :8088" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;fontStyle=1;" vertex="1" parent="c8"><mxGeometry x="245" y="66" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="c21" value="path /api/ss&#xa;crater-acl-gw :7320（JWT+ACL）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;fontStyle=1;" vertex="1" parent="c8"><mxGeometry x="460" y="66" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="c22" value="path /api/ss/usage&#xa;fs-usage :80" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;" vertex="1" parent="c8"><mxGeometry x="690" y="66" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="c23" value="path /prometheus&#xa;⚠ 目标 Service 不存在 → 503" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;fontStyle=1;" vertex="1" parent="c8"><mxGeometry x="870" y="66" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c24" value="crater-frontend Pod&#xa;nginx :80（SPA + 静态页）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;" vertex="1" parent="c9"><mxGeometry x="40" y="44" width="300" height="54" as="geometry"/></mxCell>
        <mxCell id="c25" value="crater-backend Pod&#xa;Go :8088（/api/v1 + WebSocket）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;" vertex="1" parent="c9"><mxGeometry x="360" y="44" width="300" height="54" as="geometry"/></mxCell>
        <mxCell id="c26" value="storage-server :7320（webdav）&#xa;PVC crater-rw-storage" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;" vertex="1" parent="c9"><mxGeometry x="680" y="44" width="420" height="54" as="geometry"/></mxCell>
        <mxCell id="c27" value="Volcano 作业级 NetworkPolicy&#xa;仅同作业 Pod 可入向" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="c10"><mxGeometry x="30" y="50" width="300" height="54" as="geometry"/></mxCell>
        <mxCell id="c28" value="作业 Pod 10.52.x.x :8888&#xa;Jupyter / WebIDE / 端口转发" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#c97a2b;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;fontStyle=1;" vertex="1" parent="c10"><mxGeometry x="360" y="50" width="320" height="54" as="geometry"/></mxCell>
        <mxCell id="c29" value="ingress 规则 /ingress/&lt;baseURL&gt;&#xa;→ svc-&lt;baseURL&gt;-notebook / webide" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#c97a2b;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="c10"><mxGeometry x="710" y="50" width="380" height="54" as="geometry"/></mxCell>
        <mxCell id="c30" value="⚠ 已知问题（7）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=14;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1210" y="60" width="660" height="236" as="geometry"/></mxCell>
        <mxCell id="c31" value="1　/prometheus → 目标 Service 不存在，返回 503&#xa;2　crater-tls-forward-secret 缺失 → HTTPS 回落假证书&#xa;3　proxy-body-size 默认 1m → 未加注解的入口 &gt;1MB 报 413&#xa;4　控制器单副本、无 PDB → 节点维护时入口中断&#xa;5　backend ingress sub_filter 硬编码 172.16.16.126:32057&#xa;6　snippet 注解权限开到 Critical（安全面）&#xa;7　caddy 控制器空转（LB 172.16.16.145，0 个 ingress）" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;lineHeight=160;" vertex="1" parent="c30"><mxGeometry x="12" y="44" width="630" height="180" as="geometry"/></mxCell>
        <mxCell id="c32" value="端口分层（为什么四个「80」不冲突）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=14;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1210" y="320" width="660" height="210" as="geometry"/></mxCell>
        <mxCell id="c33" value="· VIP:80 / NodePort 32057 都是 eBPF 规则，节点上无 socket&#xa;· ingress Pod 内的 80 属于 Pod 网络命名空间&#xa;· ClusterIP 的 80 是虚拟端口，每个 Service 可独立复用&#xa;· 容器真实端口可与 Service port 不同（:80 → :8088）&#xa;· 只有 NodePort / hostPort 全局唯一，才会真正冲突" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;lineHeight=160;" vertex="1" parent="c32"><mxGeometry x="12" y="44" width="630" height="150" as="geometry"/></mxCell>
        <mxCell id="c34" value="图例" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=14;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1210" y="554" width="660" height="116" as="geometry"/></mxCell>
        <mxCell id="c35" value="蓝实线 = 正常流量　紫线 = LB 层端口平移&#xa;红虚线 = 已知问题链路　灰虚线 = 配置引用" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;lineHeight=160;" vertex="1" parent="c34"><mxGeometry x="12" y="40" width="630" height="66" as="geometry"/></mxCell>
        <mxCell id="c36" value="一句话：用户只能看到 VIP，所有端口平移都在 eBPF/Service 层完成；&#xa;真正会「撞端口」的只有 NodePort 与 hostPort。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#fffde7;strokeColor=#d6b656;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;lineHeight=140;" vertex="1" parent="1"><mxGeometry x="1210" y="694" width="660" height="86" as="geometry"/></mxCell>
        <mxCell id="c37" value="HTTP :80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#3b6ea5;strokeWidth=1.6;fontColor=#3b6ea5;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c38" value="HTTP :80（/api/v1）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#3b6ea5;strokeWidth=1.6;fontColor=#3b6ea5;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c39" value="DNAT → 10.52.0.34:80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#8b7fd4;strokeWidth=1.6;fontColor=#8b7fd4;fontSize=10;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
