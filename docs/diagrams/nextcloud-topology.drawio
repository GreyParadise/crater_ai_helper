        <mxCell id="c3" value="Nextcloud 通信结构（ns nextcloud-ioply）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=21;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="640" height="34" as="geometry"/></mxCell>
        <mxCell id="c4" value="实测 2026-11-12 · 4 条入口只有 caddy 可用；全链路经 Cilium eBPF（kube-proxy 已禁用）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#666666;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="690" y="16" width="590" height="24" as="geometry"/></mxCell>
        <mxCell id="c5" value="① 客户端" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#eef2f7;strokeColor=#9aa8b8;strokeWidth=1.5;fontColor=#333333;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;startSize=30;spacingLeft=10;opacity=90;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1240" height="92" as="geometry"/></mxCell>
        <mxCell id="c6" value="② 入口层（4 条，✅ 仅 ① 可用）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ece9fb;strokeColor=#8b7fd4;strokeWidth=1.5;fontColor=#333333;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;startSize=30;spacingLeft=10;opacity=90;" vertex="1" parent="1"><mxGeometry x="40" y="168" width="1240" height="150" as="geometry"/></mxCell>
        <mxCell id="c7" value="③ Cilium eBPF 端口平移 + Service" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#333333;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;startSize=30;spacingLeft=10;opacity=90;" vertex="1" parent="1"><mxGeometry x="40" y="338" width="1240" height="132" as="geometry"/></mxCell>
        <mxCell id="c8" value="④ Pod（3 副本）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#333333;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;startSize=30;spacingLeft=10;opacity=90;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="1240" height="118" as="geometry"/></mxCell>
        <mxCell id="c9" value="⑤ 依赖与后台任务（三个 Pod 共享）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;fontColor=#333333;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;startSize=30;spacingLeft=10;opacity=90;" vertex="1" parent="1"><mxGeometry x="40" y="628" width="1240" height="118" as="geometry"/></mxCell>
        <mxCell id="c10" value="浏览器&#xa;nextcloud.lab" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#9aa8b8;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11.5;fontStyle=1;" vertex="1" parent="c5"><mxGeometry x="40" y="42" width="250" height="46" as="geometry"/></mxCell>
        <mxCell id="c11" value="桌面/手机客户端&#xa;172.16.16.153:50080" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#9aa8b8;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11.5;fontStyle=1;" vertex="1" parent="c5"><mxGeometry x="360" y="42" width="250" height="46" as="geometry"/></mxCell>
        <mxCell id="c12" value="浏览器&#xa;aicloud.ioply.cn" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#9aa8b8;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11.5;fontStyle=1;" vertex="1" parent="c5"><mxGeometry x="880" y="42" width="250" height="46" as="geometry"/></mxCell>
        <mxCell id="c13" value="（WebDAV / CalDAV 走同一入口）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#666666;fontSize=10;align=left;" vertex="1" parent="c5"><mxGeometry x="40" y="92" width="1090" height="18" as="geometry"/></mxCell>
        <mxCell id="c14" value="① caddy　VIP 172.16.16.145:80/443&#xa;反代 → nextcloud-ioply.svc:50080&#xa;L2 宣告：llm003　✅ 实测 200" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11;fontStyle=1;" vertex="1" parent="c6"><mxGeometry x="30" y="44" width="280" height="88" as="geometry"/></mxCell>
        <mxCell id="c15" value="② Service LB　VIP 172.16.16.153:50080&#xa;loadBalancerIP 手工钉死&#xa;L2 lease 在 gpu002 → ARP FAILED ❌" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11;fontStyle=1;" vertex="1" parent="c6"><mxGeometry x="340" y="44" width="280" height="88" as="geometry"/></mxCell>
        <mxCell id="c16" value="③ nginx .140　path /nextcloud/(.*) → /$2&#xa;class=caddy-disabled（集群无此类）&#xa;❌ 没有控制器实现" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="c6"><mxGeometry x="650" y="44" width="280" height="88" as="geometry"/></mxCell>
        <mxCell id="c17" value="④ nginx .140　host aicloud.ioply.cn（TLS）&#xa;证书 aicloud-ioply-tls：challenge pending 5h+ ❌&#xa;class=caddy-disabled ❌" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="c6"><mxGeometry x="960" y="44" width="270" height="88" as="geometry"/></mxCell>
        <mxCell id="c18" value="Service nextcloud-ioply&#xa;LoadBalancer · ClusterIP 10.43.170.12&#xa;port 50080 → targetPort 80&#xa;Endpoints：3 个 Pod（RR）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=11;fontStyle=1;" vertex="1" parent="c7"><mxGeometry x="30" y="44" width="330" height="84" as="geometry"/></mxCell>
        <mxCell id="c19" value="eBPF 实际映射（cilium-dbg bpf lb list）&#xa;· 172.16.16.145:80 → 10.52.2.138:80（caddy Pod）✅&#xa;· 10.43.170.12:50080 → 10.52.0.82 / .51 / .2.236（3 个 nextcloud Pod）&#xa;· 172.16.16.153:50080 → 10.52.0.82:80（有映射，但无人答 ARP）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#7a6fd0;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;lineHeight=150;" vertex="1" parent="c7"><mxGeometry x="380" y="44" width="830" height="84" as="geometry"/></mxCell>
        <mxCell id="c20" value="Pod 1　10.52.0.82&#xa;nextcloud:35.0.2-apache · apache :80&#xa;/var/www/html + /data（RWX）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="c8"><mxGeometry x="30" y="44" width="370" height="70" as="geometry"/></mxCell>
        <mxCell id="c21" value="Pod 2　10.52.1.51&#xa;nextcloud:35.0.2-apache · apache :80&#xa;/var/www/html + /data（RWX）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="c8"><mxGeometry x="430" y="44" width="370" height="70" as="geometry"/></mxCell>
        <mxCell id="c22" value="Pod 3　10.52.2.236&#xa;nextcloud:35.0.2-apache · apache :80&#xa;/var/www/html + /data（RWX）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="c8"><mxGeometry x="830" y="44" width="370" height="70" as="geometry"/></mxCell>
        <mxCell id="c23" value="探针：GET /status.php（Host: localhost）　·　TRUSTED_PROXIES = 10.52.0.0/16　·　trusted_domains = localhost, aicloud.ioply.cn" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#666666;fontSize=10;align=left;" vertex="1" parent="c8"><mxGeometry x="30" y="120" width="1180" height="18" as="geometry"/></mxCell>
        <mxCell id="c24" value="PostgreSQL&#xa;shared-pg-rw.shared-db.svc&#xa;库 nextcloud_ioply" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="c9"><mxGeometry x="30" y="44" width="280" height="64" as="geometry"/></mxCell>
        <mxCell id="c25" value="Redis&#xa;shared-redis-master.shared-redis.svc:6379&#xa;挂 zz-redis.config.php" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="c9"><mxGeometry x="330" y="44" width="320" height="64" as="geometry"/></mxCell>
        <mxCell id="c26" value="持久卷（RWX）&#xa;data 100Gi → /var/www/html/data&#xa;html 10Gi → /var/www/html" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="c9"><mxGeometry x="670" y="44" width="320" height="64" as="geometry"/></mxCell>
        <mxCell id="c27" value="CronJob&#xa;nextcloud-ioply-cron */5&#xa;php cron.php" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="c9"><mxGeometry x="1010" y="44" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="c28" value="入口现状（4 选 1）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=14;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1320" y="56" width="520" height="196" as="geometry"/></mxCell>
        <mxCell id="c29" value="✅ caddy .145 → nextcloud.lab&#xa;　　/status.php → 200（Nextcloud 35.0.2.2）&#xa;&#xa;❌ Service VIP .153:50080&#xa;　　eBPF 有映射，但 L2 宣告落在 gpu002（网卡&#xa;　　enp129s0f0），llm002 上 172.16.16.153 → ARP FAILED&#xa;&#xa;❌ nginx /nextcloud/* 与 host=aicloud.ioply.cn&#xa;　　class = caddy-disabled（集群无此 IngressClass）&#xa;　　且 ACME 证书 challenge 已 pending 5h+" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;lineHeight=145;" vertex="1" parent="c28"><mxGeometry x="12" y="44" width="490" height="140" as="geometry"/></mxCell>
        <mxCell id="c30" value="⚠ 待修 3 项" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=14;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1320" y="272" width="520" height="190" as="geometry"/></mxCell>
        <mxCell id="c31" value="1　VIP .153 不可达&#xa;　　→ 把 spec.loadBalancerIP 换成 io.cilium/lb-ipam-ips，&#xa;　　　让 L2 宣告落回与客户端同网段的节点&#xa;2　两个 nextcloud ingress 是废的&#xa;　　→ class 改回 nginx，或直接删掉；Certificate 一并清理&#xa;3　按 IP 访问会报 untrusted domain&#xa;　　→ trusted_domains 补上实际使用的主机名/IP" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;lineHeight=145;" vertex="1" parent="c30"><mxGeometry x="12" y="44" width="490" height="134" as="geometry"/></mxCell>
        <mxCell id="c32" value="设计提醒" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=14;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1320" y="482" width="520" height="150" as="geometry"/></mxCell>
        <mxCell id="c33" value="· 3 副本共享同一个 RWX html 卷：升级时容易&#xa;　出现「一半新一半旧」，官方不建议&#xa;· port 50080 只是 Service 端口，容器仍是 :80&#xa;· 所有 hop（含 caddy→Service、Pod→PG/Redis）&#xa;　都经 Cilium eBPF DNAT，无 kube-proxy" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#1a1a1a;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=6;spacingTop:4;lineHeight=145;" vertex="1" parent="c32"><mxGeometry x="12" y="44" width="490" height="96" as="geometry"/></mxCell>
