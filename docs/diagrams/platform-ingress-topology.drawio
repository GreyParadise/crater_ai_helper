<mxfile host="drawio" version="26.0.0">
  <diagram name="Platform-Ingress" id="platform-ingress">
    <mxGraphModel dx="1600" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c3" value="Crater × Rancher × Harbor　整体入口拓扑" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=21;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="760" height="34" as="geometry"/></mxCell>
        <mxCell id="c4" value="实测 2026-11-11 · 三套入口互不共用：ingress-nginx(VIP .140) / Rancher 自带 LB(.147) / Harbor NodePort(30003)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.4;fontColor=#666666;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="810" y="16" width="700" height="24" as="geometry"/></mxCell>
        <mxCell id="c5" value="① 客户端" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#eef2f7;strokeColor=#9aa8b8;strokeWidth=1.4;fontColor=#333333;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;startSize=30;spacingLeft=10;opacity=92;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1300" height="106" as="geometry"/></mxCell>
        <mxCell id="c6" value="② Cilium eBPF 负载均衡：VIP 池 + NodePort（节点上无监听进程）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ece9fb;strokeColor=#8b7fd4;strokeWidth=1.4;fontColor=#333333;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;startSize=30;spacingLeft=10;opacity=92;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="1300" height="128" as="geometry"/></mxCell>
        <mxCell id="c7" value="③ 入口控制器 / 入口组件（4 类，各管一摊）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.4;fontColor=#333333;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;startSize=30;spacingLeft=10;opacity=92;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="1300" height="150" as="geometry"/></mxCell>
        <mxCell id="c8" value="④ 后端服务（含跨模块依赖说明）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.4;fontColor=#333333;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;startSize=30;spacingLeft=10;opacity=92;" vertex="1" parent="1"><mxGeometry x="40" y="552" width="1300" height="196" as="geometry"/></mxCell>
        <mxCell id="c9" value="浏览器&#xa;Crater / Rancher / Harbor UI" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=12;fontStyle=1;" vertex="1" parent="c5"><mxGeometry x="40" y="44" width="300" height="52" as="geometry"/></mxCell>
        <mxCell id="c10" value="docker / podman&#xa;push · pull 镜像" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=12;fontStyle=1;" vertex="1" parent="c5"><mxGeometry x="370" y="44" width="280" height="52" as="geometry"/></mxCell>
        <mxCell id="c11" value="crater-cli / Agent(MCP)&#xa;kubectl / helm" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=12;fontStyle=1;" vertex="1" parent="c5"><mxGeometry x="680" y="44" width="280" height="52" as="geometry"/></mxCell>
        <mxCell id="c12" value="★ 三套入口彼此独立：&#xa;Crater 走 ingress-nginx，Rancher 走自己的 LB，Harbor 走 NodePort" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#fffde7;strokeColor=#d6b656;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="c5"><mxGeometry x="990" y="44" width="290" height="52" as="geometry"/></mxCell>
        <mxCell id="c13" value="VIP 池（每个 LoadBalancer Service 独占一个 IP，由 Cilium LB IPAM 池 01-lb-pool 分配）&#xa;.140 ingress-nginx　.147 rancher　.149 grafana　.145 caddy　.142 headlamp　.143 hubble　.144 jupyterhub　.146 kubero　.150 kite　.152/.153 asr&#xa;NodePort：32057/31432 = ingress-nginx　31880/32354 = rancher　30003/30013 = Harbor　—— L2 announcement @ens12，k3s servicelb 已禁用" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#8b7fd4;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="c6"><mxGeometry x="30" y="44" width="1240" height="84" as="geometry"/></mxCell>
        <mxCell id="c14" value="ingress-nginx v1.15.1&#xa;IngressClass nginx ★default★&#xa;15 个 ingress 全走这里" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;fontStyle=1;" vertex="1" parent="c7"><mxGeometry x="30" y="44" width="240" height="96" as="geometry"/></mxCell>
        <mxCell id="c15" value="Rancher 内置 nginx&#xa;VIP .147 :80/:443&#xa;TLS 自己终结，不经 IngressClass" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;fontStyle=1;" vertex="1" parent="c7"><mxGeometry x="290" y="44" width="240" height="96" as="geometry"/></mxCell>
        <mxCell id="c16" value="Harbor 内置 nginx&#xa;NodePort 30003 / 30013&#xa;无 ingress、无 VIP" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;fontStyle=1;" vertex="1" parent="c7"><mxGeometry x="550" y="44" width="230" height="96" as="geometry"/></mxCell>
        <mxCell id="c17" value="caddy 2.11.7&#xa;VIP .145　Caddyfile&#xa;（IngressClass caddy 使用者 0）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;" vertex="1" parent="c7"><mxGeometry x="800" y="44" width="230" height="96" as="geometry"/></mxCell>
        <mxCell id="c18" value="直连 LoadBalancer（无 ingress 层）&#xa;Grafana .149　Headlamp .142　Hubble .143&#xa;JupyterHub .144　Kubero .146　Kite .150" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=10.5;" vertex="1" parent="c7"><mxGeometry x="1050" y="44" width="230" height="96" as="geometry"/></mxCell>
        <mxCell id="c19" value="Crater" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="c8"><mxGeometry x="30" y="42" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="c20" value="frontend-svc :80 → Pod:80&#xa;backend-svc :80 → Pod:8088&#xa;acl-gw:7320 → storage-server（+PVC）&#xa;↳ 作业镜像从 Harbor:30003 拉（harbor-cred）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f7fbf4;strokeColor=#82b366;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;lineHeight=150;" vertex="1" parent="c19"><mxGeometry x="12" y="30" width="276" height="108" as="geometry"/></mxCell>
        <mxCell id="c21" value="Rancher" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="c8"><mxGeometry x="350" y="42" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="c22" value="cattle-system/rancher :443&#xa;（API + UI，自成一体）&#xa;rancher-webhook · fleet&#xa;↳ Fleet/Helm 下发 Crater chart" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f7fbf4;strokeColor=#82b366;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;lineHeight=150;" vertex="1" parent="c21"><mxGeometry x="12" y="30" width="216" height="108" as="geometry"/></mxCell>
        <mxCell id="c23" value="Harbor" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="c8"><mxGeometry x="610" y="42" width="340" height="150" as="geometry"/></mxCell>
        <mxCell id="c24" value="harbor-nodeport → harbor-nginx(:8080)&#xa;→ core / portal / jobservice / registry:5000&#xa;DB + Redis + PVC registry 200Gi&#xa;（crater-images 命名空间）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f7fbf4;strokeColor=#82b366;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;lineHeight=150;" vertex="1" parent="c23"><mxGeometry x="12" y="30" width="316" height="108" as="geometry"/></mxCell>
        <mxCell id="c25" value="监控 / 其它" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="c8"><mxGeometry x="970" y="42" width="310" height="150" as="geometry"/></mxCell>
        <mxCell id="c26" value="Grafana .149（集群监控 iframe）&#xa;Prometheus（/prometheus 路由已坏⚠）&#xa;Nextcloud（caddy .145）· Hubble/Headlamp&#xa;↳ 抓节点与 Crater Pod 指标" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f7fbf4;strokeColor=#82b366;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;lineHeight=150;" vertex="1" parent="c25"><mxGeometry x="12" y="30" width="286" height="108" as="geometry"/></mxCell>
        <mxCell id="c27" value="三条入口，互不可替代" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=14;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1372" y="56" width="700" height="200" as="geometry"/></mxCell>
        <mxCell id="c28" value="· Crater：唯一使用 IngressClass=nginx（VIP .140，path 路由）&#xa;· Rancher：自带 LoadBalancer VIP .147:80/443（NodePort 31880/32354），&#xa;　 TLS 由 Rancher 自己终结，不经过 .140&#xa;· Harbor：纯 NodePort 30003(http)/30013(https)，无 ingress、无 VIP&#xa;　 docker 必须用 172.16.16.126:30003 且配 insecure-registry&#xa;· caddy：Caddyfile 站点（nextcloud.lab / .145），IngressClass caddy 空转" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;lineHeight=155;" vertex="1" parent="c27"><mxGeometry x="12" y="44" width="670" height="144" as="geometry"/></mxCell>
        <mxCell id="c29" value="端口 / VIP 归属表" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=14;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1372" y="270" width="700" height="250" as="geometry"/></mxCell>
        <mxCell id="c30" value=".140  ingress-nginx      VIP 80/443 · NP 32057/31432&#xa;.147  rancher            VIP 80/443 · NP 31880/32354&#xa;.149  grafana            VIP 80&#xa;.145  caddy              VIP 80/443&#xa;.142  headlamp  .143 hubble  .144 jupyterhub&#xa;.146  kubero    .150 kite    .152/.153 asr-test&#xa;—— Harbor 例外：不走 VIP，NodePort 30003 / 30013" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;lineHeight=160;fontFamily=Courier New;" vertex="1" parent="c29"><mxGeometry x="12" y="44" width="670" height="194" as="geometry"/></mxCell>
        <mxCell id="c31" value="⚠ 一并发现的入口层风险" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=14;fontStyle=1;container=1;pointerEvents=0;collapsible=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1372" y="534" width="700" height="210" as="geometry"/></mxCell>
        <mxCell id="c32" value="1　/monitoring prometheus-ui 指向不存在的 Service → 503&#xa;2　crater-tls-forward-secret 缺失 → 作业 https 入口用假证书&#xa;3　proxy-body-size 默认 1m（仅 storage/Harbor 相关开了大值）&#xa;4　ingress-nginx 单副本、无 PDB&#xa;5　sub_filter 硬编码 172.16.16.126:32057&#xa;6　Harbor 仅 NodePort：节点 IP 变更/加节点都要改客户端配置&#xa;7　VIP 已占 11 个（池余 49），caddy 那个 .145 目前只服务 Nextcloud" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;lineHeight=155;" vertex="1" parent="c31"><mxGeometry x="12" y="44" width="670" height="154" as="geometry"/></mxCell>
        <mxCell id="c33" value="一句话：Crater 的 Ingress 只服务 Crater 自己；&#xa;Rancher 与 Harbor 各自有入口，三者唯一的交集是&#xa;「Crater 作业从 Harbor 拉镜像」和「Rancher 部署/监控 Crater」。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fillColor=#fffde7;strokeColor=#d6b656;strokeWidth=1.4;fontColor=#1a1a1a;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;lineHeight=145;" vertex="1" parent="1"><mxGeometry x="1372" y="760" width="700" height="80" as="geometry"/></mxCell>
        <mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#3b6ea5;strokeWidth=1.6;fontColor=#3b6ea5;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#c97a2b;strokeWidth=1.6;fontColor=#c97a2b;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.45;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#3b6ea5;strokeWidth=1.6;fontColor=#3b6ea5;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#8b7fd4;strokeWidth=1.6;fontColor=#8b7fd4;fontSize=10;exitX=0.12;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#8b7fd4;strokeWidth=1.6;fontColor=#8b7fd4;fontSize=10;exitX=0.32;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#8b7fd4;strokeWidth=1.6;fontColor=#8b7fd4;fontSize=10;exitX=0.52;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#8b7fd4;strokeWidth=1.6;fontColor=#8b7fd4;fontSize=10;exitX=0.72;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#8b7fd4;strokeWidth=1.6;fontColor=#8b7fd4;fontSize=10;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#82b366;strokeWidth=1.6;fontColor=#82b366;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#82b366;strokeWidth=1.6;fontColor=#82b366;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Microsoft YaHei;strokeColor=#82b366;strokeWidth=1.6;fontColor=#82b366;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
